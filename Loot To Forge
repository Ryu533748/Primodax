    while true do
        task.wait(0.5)
        if not LocalPlayer.Character then continue end

        -- Auto Rebirth
        if State.AutoRebirth then
            local re = game:GetService("ReplicatedStorage"):FindFirstChild("Rebirth")
                or game:GetService("ReplicatedStorage"):FindFirstChild("DoRebirth")
            if re then re:FireServer() end
        end

        -- Auto Buy Upgrades
        if State.AutoBuyUpgrades then
            local re = game:GetService("ReplicatedStorage"):FindFirstChild("BuyUpgrade")
            if re then re:FireServer(State.UpgradesToBuy) end
        end
    end
end)

